{
  "id": null,
  "title": "ESP32 Battery Monitor",
  "uid": "esp32-battery",
  "timezone": "browser",
  "refresh": "1s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Battery SOC",
      "type": "gauge",
      "gridPos": { "h": 9, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"soc\") |> last()"
      }]
    },
    {
      "title": "Voltage",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 3 }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"voltage\") |> last()"
      }]
    },
    {
      "title": "RSSI",
      "type": "gauge",
      "gridPos": { "h": 9, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "min": -90,
          "max": -30,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -70 },
              { "color": "yellow", "value": -60 },
              { "color": "green", "value": -50 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"rssi\") |> last()"
      }]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "dthms",
          "color": { "mode": "fixed", "fixedColor": "text" }
        }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"uptime\") |> last()"
      }]
    },
    {
      "title": "Power",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "ON", "color": "green" }, "0": { "text": "OFF", "color": "red" } } }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"power_online\") |> last()"
      }]
    },
    {
      "title": "Uptime %",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 3 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"power_online\") |> mean() |> map(fn: (r) => ({r with _value: r._value * 100.0}))"
      }]
    },
    {
      "title": "Supply Voltage",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 3 }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"supply_voltage\") |> last()"
      }]
    },
    {
      "title": "Heap Free",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20000 },
              { "color": "green", "value": 40000 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: -1m) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"heap_free\") |> last()"
      }]
    },
    {
      "title": "Voltage & Current",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "decimals": 3, "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "voltage" }, "properties": [{ "id": "displayName", "value": "Voltage" }, { "id": "unit", "value": "volt" }, { "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }, { "id": "custom.axisSoftMin", "value": 10.0 }, { "id": "custom.axisSoftMax", "value": 14.6 }] },
          { "matcher": { "id": "byName", "options": "battery_current" }, "properties": [{ "id": "displayName", "value": "Battery Current" }, { "id": "unit", "value": "amp" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "supply_current" }, "properties": [{ "id": "displayName", "value": "Supply Current" }, { "id": "unit", "value": "amp" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "fixedColor": "#ff9800", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"voltage\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        },
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"battery_current\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        },
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"supply_current\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "title": "Power",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": { "unit": "watt", "decimals": 3, "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "battery_power" }, "properties": [{ "id": "displayName", "value": "Battery" }, { "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "supply_power" }, "properties": [{ "id": "displayName", "value": "Power Supply" }, { "id": "color", "value": { "fixedColor": "#ff9800", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"battery_power\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        },
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"supply_power\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "title": "Heap",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "heap_free" }, "properties": [{ "id": "displayName", "value": "Free" }, { "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "heap_min_free" }, "properties": [{ "id": "displayName", "value": "Min Free (since boot)" }, { "id": "color", "value": { "fixedColor": "#ff9800", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"heap_free\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        },
        {
          "datasource": { "type": "influxdb" },
          "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"heap_min_free\") |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: false)"
        }
      ]
    },
    {
      "title": "SOC",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "displayName": "SOC", "custom": { "lineWidth": 2 } }
      },
      "targets": [{
        "datasource": { "type": "influxdb" },
        "query": "from(bucket: \"battery\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"soc\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
      }]
    }
  ],
  "schemaVersion": 39
}
