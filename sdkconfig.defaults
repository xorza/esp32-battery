# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K).
# AppState::new takes SensorData by value (~4KB inline heapless::Vec for history) + Mutex + Arc
# construction all transit the stack before the Arc escapes to heap.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
CONFIG_FREERTOS_HZ=1000

# OTA support: dual app partitions (ota_0 + ota_1) + otadata
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Flash size (set to match board: 4MB or 8MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Memory optimization ---

# WiFi RX buffers: default 10 × ~1.6KB = 16KB → 6 × 1.6KB = 9.6KB (saves ~6KB)
# CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# WiFi dynamic buffers: default 32 each, reduce to cap peak usage
# CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12

# TCP window/send buffers: default 5760 each, reduce to 2× MSS (saves ~3KB per socket)
# CONFIG_LWIP_TCP_WND_DEFAULT=2880
# CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

# Fewer sockets: HTTP(2) + DNS(1) = 3, plus margin
CONFIG_LWIP_MAX_SOCKETS=7

# Fewer simultaneous TCP connections (default 16 each)
CONFIG_LWIP_MAX_ACTIVE_TCP=6
CONFIG_LWIP_MAX_LISTENING_TCP=5
CONFIG_LWIP_SO_LINGER=y

# Move functions from IRAM to flash (frees IRAM for heap)
# CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Use nano printf (smaller stack per printf call, no %lld support)
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y

# WiFi IRAM→flash (saves ~27KB IRAM, slight throughput reduction)
# CONFIG_ESP_WIFI_IRAM_OPT=n
# CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Reduce system task stacks
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048

# --- TCP tuning ---

# Reduce TIME_WAIT duration from 120s to 4s (MSL * 2)
CONFIG_LWIP_TCP_MSL=2000

# Reduce FIN_WAIT_2 timeout from 20s to 2s
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=2000

# Disable WiFi power save to avoid missed packets causing half-open connections
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# Task watchdog: enabled for explicit subscription (xy supervisor only).
# Idle tasks are NOT auto-subscribed — OTA flash writes block IDLE >5s and
# would otherwise trip it. Auto-init is also off so the xy thread owns
# init/timeout (see src/xy.rs).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# HTTPS server support
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# Route esp_log output to the built-in USB-Serial/JTAG peripheral so logs
# are visible on /dev/ttyACM0 without a separate UART-to-USB cable.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
