# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K).
# AppState::new takes SensorData by value (~4KB inline heapless::Vec for history) + Mutex + Arc
# construction all transit the stack before the Arc escapes to heap.
# Captive scan path also pushes wide: scan_n::<10> collects 10× AccessPointInfo
# (~80 B each, with String<32> SSID) + per-iter try_from frame on top of the
# FSM step. 16000 overflowed by ~100 bytes during a scan-coincident tick;
# 20000 leaves comfortable headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
CONFIG_FREERTOS_HZ=1000

# OTA support: dual app partitions (ota_0 + ota_1) + otadata
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Flash size (set to match board: 4MB or 8MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Memory optimization ---

# WiFi RX buffers: default 10 × ~1.6KB = 16KB → 6 × 1.6KB = 9.6KB (saves ~6KB)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# WiFi dynamic buffers: default 32 each, reduce to cap peak usage
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# TCP window/send buffers: default 5760 each, reduce to 2× MSS (saves ~3KB per socket)
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

# Fewer sockets: HTTP(2) + DNS(1) = 3, plus margin
CONFIG_LWIP_MAX_SOCKETS=7

# Fewer simultaneous TCP connections (default 16 each)
CONFIG_LWIP_MAX_ACTIVE_TCP=6
CONFIG_LWIP_MAX_LISTENING_TCP=5
CONFIG_LWIP_SO_LINGER=y

# Move functions from IRAM to flash (frees IRAM for heap)
# CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Use nano printf (smaller stack per printf call, no %lld support)
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y

# WiFi IRAM→flash (saves ~27KB IRAM, slight throughput reduction)
# CONFIG_ESP_WIFI_IRAM_OPT=n
# CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Reduce system task stacks
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048

# --- TCP tuning ---

# Reduce TIME_WAIT duration from 120s to 4s (MSL * 2)
CONFIG_LWIP_TCP_MSL=2000

# Reduce FIN_WAIT_2 timeout from 20s to 2s
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=2000

# SNTP poll interval: default 1h is too long given internal-RC drift between
# syncs. 5 min keeps wall-clock within RC drift bounds without flooding pool.ntp.
CONFIG_LWIP_SNTP_UPDATE_DELAY=300000

# Disable WiFi power save to avoid missed packets causing half-open connections
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# Task watchdog: enabled for explicit subscription (xy supervisor only).
# Idle tasks are NOT auto-subscribed — OTA flash writes block IDLE >5s and
# would otherwise trip it. Auto-init is also off so the xy thread owns
# init/timeout (see src/xy.rs).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Free TX buffer / CA / peer cert when sessions are idle.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y

# HTTPS server support
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# mbedTLS memory tuning. We control response sizes, so the 16KB default TX
# buffer is wasteful. IN must stay 16KB (TLS spec — no way to negotiate down,
# and esp-idf #14444 leaks below 16KB). Server-side, we don't need to retain
# the peer cert (we don't do client-cert auth).
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# We use a P-256 ECDSA cert; no other curves are reachable. Each disabled
# curve drops ~2-4 KB of flash. Curve25519 stays for browser X25519 ECDHE.
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

# Trim TLS features we don't use. ALPN is HTTP/2 only; renegotiation is
# deprecated; MFL is RFC 6066 fragment-length negotiation we don't need.
CONFIG_MBEDTLS_SSL_ALPN=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_SSL_MAX_FRAGMENT_LENGTH=n

# Drop the mbedTLS error-string table (~6-8 KB). Logs become numeric codes.
CONFIG_MBEDTLS_ERROR_STRINGS=n

# Drop esp_err_t → string table (~3-6 KB). Same tradeoff.
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

# LAN is v4-only, but IPv6 must stay enabled: esp-idf-sys's compile-time
# libc constant checks reference AF_INET6/PF_INET6 unconditionally and
# fail to build when LWIP_IPV6 is disabled.
CONFIG_LWIP_IPV6=y

# Use ROM TLSF heap allocator (saves ~2KB IRAM + flash).
CONFIG_HEAP_TLSF_USE_ROM_IMPL=y

# AMPDU off — drops WiFi throughput 30-50% but saves ~3-5KB RAM.
# Dashboard traffic is tiny so the throughput hit is invisible.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# GDB stub eats ~6KB; we don't connect a debugger over serial.
CONFIG_ESP_GDBSTUB_ENABLED=n

# mDNS: dashboard advertises one HTTPS service; default 10 slots is wasteful.
CONFIG_MDNS_MAX_SERVICES=2

# Route esp_log output to the built-in USB-Serial/JTAG peripheral so logs
# are visible on /dev/ttyACM0 without a separate UART-to-USB cable.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
